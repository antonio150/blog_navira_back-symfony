<!DOCTYPE html>
<html>
  <body style="margin:0; padding:0; background:#f5f7fb; font-family: Arial, Helvetica, sans-serif;">
    
    <table width="100%" cellpadding="0" cellspacing="0" style="padding: 30px 0;">
      <tr>
        <td align="center">

          <table width="600" cellpadding="0" cellspacing="0" style="background:#ffffff; border-radius:8px; padding:25px;">

            <tr>
              <td align="center" style="padding-bottom: 10px;">
                <h2 style="margin:0; color:#1b1b1b;">
                  Bonjour {{ nom }}
                </h2>
              </td>
            </tr>

            <tr>
              <td style="font-size:15px; color:#333; line-height:22px;">
                <p style="margin-bottom:10px;">
                  Vous avez reçu un nouveau commentaire sur la page
                  <a href="{{ url }}" style="color:#2563eb; text-decoration:none; font-weight:bold;">cliquer ici</a>.
                </p>

                <p style="margin-bottom:10px;">
                  Le commentaire a été posté sur le document :
                </p>
                <p>
                  <strong>{{ titre }}</strong>.
                </p>

                <p style="margin-bottom:15px;">
                  Merci de vous connecter pour le consulter.
                </p>

                <p style="margin-top:20px;">
                  Cordialement,<br>
                  <strong>L'équipe Navira</strong>
                </p>
              </td>
            </tr>

            <tr>
              <td align="center" style="padding-top:20px;">
                <img src="{{ image_url }}" alt="Navira" width="180" style="border-radius:8px;">
              </td>
            </tr>

          </table>

        </td>
      </tr>
    </table>

  </body>
</html>
